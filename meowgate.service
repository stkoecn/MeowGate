[Unit]
Description=MeowGate Clash Node User Routing Manager & Gateway
Documentation=https://github.com/agegr/MeowGate
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/meowgate
ExecStart=/usr/local/bin/meowgate
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
